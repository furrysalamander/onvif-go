<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML Catalog for cmd/onvifgen.

  Maps schema/wsdl namespaces + remote schemaLocation URLs to their
  vendored copies under internal/catalog/. The generator uses this catalog so
  it never fetches schemas from the network.

  Maintained by hand; integrity of the vendored files is checked by the
  checksums in NOTICE.md (see `go test ./internal/catalog`).
-->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">

  <!-- ===================== ONVIF schemas ===================== -->
  <uri name="http://www.onvif.org/ver10/device/wsdl"          uri="onvif/ver10/device/wsdl/devicemgmt.wsdl"/>
  <uri name="http://www.onvif.org/ver10/media/wsdl"           uri="onvif/ver10/media/wsdl/media.wsdl"/>
  <uri name="http://www.onvif.org/ver20/media/wsdl"           uri="onvif/ver20/media/wsdl/media.wsdl"/>
  <uri name="http://www.onvif.org/ver20/ptz/wsdl"             uri="onvif/ver20/ptz/wsdl/ptz.wsdl"/>
  <uri name="http://www.onvif.org/ver10/events/wsdl"          uri="onvif/ver10/events/wsdl/event.wsdl"/>
  <uri name="http://www.onvif.org/ver20/imaging/wsdl"         uri="onvif/ver20/imaging/wsdl/imaging.wsdl"/>
  <uri name="http://www.onvif.org/ver10/schema"               uri="onvif/ver10/schema/onvif.xsd"/>
  <uri name="http://www.onvif.org/ver10/schema/common"       uri="onvif/ver10/schema/common.xsd"/>

  <!-- onvif.xsd uses an unsuffixed import path; map it to common.xsd too -->
  <uri name="http://www.onvif.org/ver10/schema/common.xsd"    uri="onvif/ver10/schema/common.xsd"/>

  <!-- ===================== Phase 2 ONVIF services ===================== -->
  <uri name="http://www.onvif.org/ver10/accessrules/wsdl"           uri="onvif/ver10/accessrules/wsdl/accessrules.wsdl"/>
  <uri name="http://www.onvif.org/ver10/actionengine/wsdl"         uri="onvif/ver10/actionengine.wsdl"/>
  <uri name="http://www.onvif.org/ver10/advancedsecurity/wsdl"     uri="onvif/ver10/advancedsecurity/wsdl/advancedsecurity.wsdl"/>
  <uri name="http://www.onvif.org/ver10/appmgmt/wsdl"              uri="onvif/ver10/appmgmt/wsdl/appmgmt.wsdl"/>
  <uri name="http://www.onvif.org/ver10/authenticationbehavior/wsdl" uri="onvif/ver10/authenticationbehavior/wsdl/authenticationbehavior.wsdl"/>
  <uri name="http://www.onvif.org/ver10/credential/wsdl"           uri="onvif/ver10/credential/wsdl/credential.wsdl"/>
  <uri name="http://www.onvif.org/ver10/deviceIO/wsdl"             uri="onvif/ver10/deviceio.wsdl"/>
  <uri name="http://www.onvif.org/ver10/display/wsdl"              uri="onvif/ver10/display.wsdl"/>
  <uri name="http://www.onvif.org/ver10/accesscontrol/wsdl"        uri="onvif/ver10/pacs/accesscontrol.wsdl"/>
  <uri name="http://www.onvif.org/ver10/doorcontrol/wsdl"          uri="onvif/ver10/pacs/doorcontrol.wsdl"/>
  <uri name="http://www.onvif.org/ver10/pacs"                      uri="onvif/ver10/pacs/types.xsd"/>
  <uri name="http://www.onvif.org/ver10/provisioning/wsdl"         uri="onvif/ver10/provisioning/wsdl/provisioning.wsdl"/>
  <uri name="http://www.onvif.org/ver10/receiver/wsdl"             uri="onvif/ver10/receiver.wsdl"/>
  <uri name="http://www.onvif.org/ver10/recording/wsdl"            uri="onvif/ver10/recording.wsdl"/>
  <uri name="http://www.onvif.org/ver10/replay/wsdl"               uri="onvif/ver10/replay.wsdl"/>
  <uri name="http://www.onvif.org/ver10/schedule/wsdl"             uri="onvif/ver10/schedule/wsdl/schedule.wsdl"/>
  <uri name="http://www.onvif.org/ver10/search/wsdl"               uri="onvif/ver10/search.wsdl"/>
  <uri name="http://www.onvif.org/ver10/thermal/wsdl"              uri="onvif/ver10/thermal/wsdl/thermal.wsdl"/>
  <uri name="http://www.onvif.org/ver10/uplink/wsdl"               uri="onvif/ver10/uplink/wsdl/uplink.wsdl"/>
  <uri name="http://www.onvif.org/ver20/analytics/wsdl"            uri="onvif/ver20/analytics/wsdl/analytics.wsdl"/>
  <uri name="http://www.onvif.org/ver20/analytics"                 uri="onvif/ver20/analytics/rules.xsd"/>
  <uri name="http://www.onvif.org/ver20/analytics/humanbody"       uri="onvif/ver20/analytics/humanbody.xsd"/>
  <uri name="http://www.onvif.org/ver20/analytics/humanface"        uri="onvif/ver20/analytics/humanface.xsd"/>
  <uri name="http://www.onvif.org/ver20/analytics/radiometry"      uri="onvif/ver20/analytics/radiometry.xsd"/>

  <!-- ===================== OASIS WS-Notification / WS-ResourceFramework ===================== -->
  <uri name="http://docs.oasis-open.org/wsn/b-2"             uri="external/oasis/wsn/b-2.xsd"/>
  <uri name="http://docs.oasis-open.org/wsn/t-1"             uri="external/oasis/wsn/t-1.xsd"/>
  <uri name="http://docs.oasis-open.org/wsn/bw-2"            uri="external/oasis/wsn/bw-2.wsdl"/>
  <uri name="http://docs.oasis-open.org/wsrf/rw-2"           uri="external/oasis/wsrf/rw-2.wsdl"/>
  <uri name="http://docs.oasis-open.org/wsrf/bf-2"           uri="external/oasis/wsrf/bf-2.xsd"/>
  <uri name="http://docs.oasis-open.org/wsrf/r-2"            uri="external/oasis/wsrf/r-2.xsd"/>

  <!-- ===================== W3C support schemas ===================== -->
  <uri name="http://www.w3.org/2005/08/addressing"           uri="external/w3c/2005/08/addressing/ws-addr.xsd"/>
  <uri name="http://www.w3.org/2005/05/xmlmime"             uri="external/w3c/2005/05/xmlmime/xmlmime.xsd"/>
  <uri name="http://www.w3.org/2003/05/soap-envelope"       uri="external/w3c/2003/05/soap-envelope/soap-envelope.xsd"/>
  <uri name="http://www.w3.org/2004/08/xop/include"         uri="external/w3c/2004/08/xop/include/xop-include.xsd"/>
  <uri name="http://www.w3.org/XML/1998/namespace"          uri="external/w3c/2001/xml.xsd"/>

  <!-- ===================== URL-keyed fallbacks (schemaLocation values) ===================== -->
  <!-- These map the full http(s) URLs that some schemas use as schemaLocation
       directly to their vendored copies, so resolution works even when the
       importer didn't quote a namespace (xs:include) or used a non-namespace
       URL (some W3C imports). -->
  <system systemId="http://docs.oasis-open.org/wsn/b-2.xsd"             uri="external/oasis/wsn/b-2.xsd"/>
  <system systemId="http://docs.oasis-open.org/wsn/t-1.xsd"             uri="external/oasis/wsn/t-1.xsd"/>
  <system systemId="http://docs.oasis-open.org/wsn/bw-2.wsdl"           uri="external/oasis/wsn/bw-2.wsdl"/>
  <system systemId="http://docs.oasis-open.org/wsrf/rw-2.wsdl"          uri="external/oasis/wsrf/rw-2.wsdl"/>
  <system systemId="http://docs.oasis-open.org/wsrf/bf-2.xsd"           uri="external/oasis/wsrf/bf-2.xsd"/>
  <system systemId="http://docs.oasis-open.org/wsrf/r-2.xsd"            uri="external/oasis/wsrf/r-2.xsd"/>
  <system systemId="http://www.w3.org/2005/08/addressing/ws-addr.xsd"   uri="external/w3c/2005/08/addressing/ws-addr.xsd"/>
  <system systemId="https://www.w3.org/2005/05/xmlmime"                uri="external/w3c/2005/05/xmlmime/xmlmime.xsd"/>
  <system systemId="https://www.w3.org/2003/05/soap-envelope"          uri="external/w3c/2003/05/soap-envelope/soap-envelope.xsd"/>
  <system systemId="https://www.w3.org/2004/08/xop/include"             uri="external/w3c/2004/08/xop/include/xop-include.xsd"/>
  <system systemId="http://www.w3.org/2001/xml.xsd"                     uri="external/w3c/2001/xml.xsd"/>
</catalog>